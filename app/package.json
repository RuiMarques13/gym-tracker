{
  "name": "gym-tracker",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:core": "vitest run --config vitest.core.config.ts",
    "seed": "node ../tools/import-excel/build-seed.mjs",
    "build:android": "ng build && npx cap sync android",
